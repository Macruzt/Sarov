CREATE TRIGGER `generar_numero_documento` BEFORE INSERT ON `orders` FOR EACH ROW BEGIN
    DECLARE nuevo_numero INT;
    SET nuevo_numero = (SELECT COALESCE(MAX(os_sarov), 0) + 1 FROM orders);
    SET NEW.os_sarov = LPAD(nuevo_numero, 5, '0');
END
$$
